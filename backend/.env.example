# Figgy Environment Configuration
PROJECT_NAME="Figgy AI Companion Backend"
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=huihui_ai/qwen3-abliterated
LLM_TEMPERATURE=0.8
LLM_TIMEOUT=60.0
MAX_CONTEXT_TOKENS=4096

DEFAULT_PERSONA=dark_comedian
DEFAULT_INTENSITY=0.85
DATABASE_URL=sqlite+aiosqlite:///./figgy.db
MAX_WORKING_MEMORY_TURNS=10
AUTO_EXTRACT_MEMORY=True

API_KEY=figgy-secret-key
REQUIRE_API_KEY=False
DEFAULT_DEVICE_ID=figgy-001
